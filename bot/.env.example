# Copie ce fichier en ".env" (sans .example) et remplis les trois valeurs.
# Ne partage JAMAIS ton token : c'est le mot de passe du bot.

# Developer Portal > ton application > Bot > Reset Token
DISCORD_TOKEN=

# Developer Portal > ton application > General Information > Application ID
CLIENT_ID=

# Discord > clic droit sur le serveur L'Équipage > Copier l'identifiant du serveur
GUILD_ID=
